# 编译产物
*.o
/skills/skill_data.c

# IDE / AI工具目录
.vscode/
.claude/

# file_server 环境与运行生成文件
resource/file_server/.venv/
resource/file_server/upload_files/
resource/file_server/file_db.sqlite
# 组件依赖探测的缓存，探测一次几十秒，装完依赖会重建
resource/file_server/.components_cache.json
# MCP 网关的进程号文件，deploy.bat 启动网关时写
resource/file_server/mcp_gateway.pid

# file_server 自带的测试目录：忽略全部内容，只保留 *.py
resource/file_server/test/*
!resource/file_server/test/*.py

# Kconfig 离线校验脚本运行时生成的临时文件
/scripts/kconfig_check/Kconfig.test
/scripts/kconfig_check/.config.audio
/scripts/kconfig_check/.config.scen

# python缓存
__pycache__/
*.py[cod]
*$py.class
*.pyc

# 系统杂项
*.bin
*.elf
*.log
.DS_Store

# kconfig
Kconfig

# web 控制台：工具链、依赖与产物全部不进版本库
/resource/web/server/.jdk/
/resource/web/server/.maven/
/resource/web/server/target/
/resource/web/server/data/
/resource/web/client/node_modules/
/resource/web/client/dist/
/resource/web/client/.vite/
/resource/web/*.zip
/resource/web/.run/
