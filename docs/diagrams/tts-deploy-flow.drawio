<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="drawio-skill" version="21.0.0" type="device">
  <diagram name="TTS Deploy Flow" id="tts-deploy-flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1"
                   connect="1" arrows="1" fold="1" page="1" pageScale="1"
                   pageWidth="1200" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 主流程 -->
        <mxCell id="n1" value="git clone&#xa;CXSforHPU/Agent"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;arcSize=50;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="bash deploy.sh --tts&#xa;deploy.bat --tts&#xa;一条命令跑完下面几步"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;arcSize=50;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="230" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="装配环境&#xa;uv sync 按算力选 cpu / cu126 / cu130"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="fetch_tts.py dicts&#xa;8 个词表，35.3 MB"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="fetch_tts.py voice&#xa;两个音色四份权重，590 MiB"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="680" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="fetch_tts.py assets&#xa;底模、G2PW、nltk、FFmpeg"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="830" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="fetch_tts.py check&#xa;逐项核对 SHA256"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="980" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="补韩语依赖&#xa;eunjeon + setuptools&lt;81"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="1130" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="启动 main.py&#xa;监听 8000"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="1280" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="POST /tts&#xa;整条 WAV 或流式帧"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;arcSize=50;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="1430" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- 脚本参数 -->
        <mxCell id="t1" value="两个脚本参数对得上&#xa;--tts 装依赖组并拉资产&#xa;--check 只部署不起服务&#xa;--start-only 只起服务&#xa;--print 只打印 uv 命令&#xa;--port --host 换监听地址&#xa;--autoload 启动即预热模型&#xa;--speaker NAME 设默认音色&#xa;--mirror GitHub 走 gh-proxy"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="230" width="420" height="230" as="geometry" />
        </mxCell>

        <!-- 下载来源 -->
        <mxCell id="s1" value="raw.githubusercontent.com&#xa;钉住的 UPSTREAM_COMMIT"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="530" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="ModelScope&#xa;Caoxiansong/da_fei_yv"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="680" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="ModelScope&#xa;XXXXRT/GPT-SoVITS-Pretrained"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="830" width="420" height="60" as="geometry" />
        </mxCell>

        <!-- 边界与说明 -->
        <mxCell id="b1" value="入库：推理子集 169 个文件&#xa;参考音频、音色注册表、导出记录"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="980" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="不要手工 uv sync 部署，统一用脚本&#xa;它剪掉没点名的组：tts 组 125 个依赖卸掉、torch 退回 CPU&#xa;脚本同步前查 librosa 保留 tts 组，同步后补 eunjeon"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="1130" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="不入库：词表、底模、权重、FFmpeg&#xa;由 fetch_tts.py 取，SHA256 校验"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="640" y="1280" width="420" height="60" as="geometry" />
