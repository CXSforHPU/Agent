<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="drawio-skill" version="21.0.0" type="device">
  <diagram name="TTS Runtime Flow" id="tts-runtime-flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1"
                   connect="1" arrows="1" fold="1" page="1" pageScale="1"
                   pageWidth="1400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="LLM 回复文本&#xa;agent_tts_speak() 入队，tts_spk 线程取出"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;arcSize=30;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="tts_post() 一条回复只发一次 POST /tts&#xa;stream=true、block_seconds=1.5、channels=1"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="main.py 选音色，取常驻管线&#xa;speaker 缺省时取 TTS_SPEAKER，否则取 da_fei_yv_plus"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="_tts_stream_frames() 用 streaming_mode 合成&#xa;_TtsBlocker 攒够 1.5 s 音频封一帧&#xa;数据段补零到 2 048 字节的整数倍"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="响应帧序列&#xa;[4 字节小端长度][自带 WAV 头的可播音频]"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="720" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="tts_read_frame_to_fd() 写进空闲槽&#xa;/sdcard/tts0.wav 与 /sdcard/tts1.wav 交替"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="880" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="等上一帧播完，agent_driver_audio_play() 播这一帧&#xa;槽位取反后接着收"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="1040" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="服务端还有下一帧？"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="220" y="1200" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="喇叭出声&#xa;drv_i2s 把单声道复制成左右两个 PCM 槽"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;arcSize=30;"
                vertex="1" parent="1">
          <mxGeometry x="120" y="1400" width="520" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="另一条入口：msh_agent_tts&#xa;stream=false，服务端一次返回整条 WAV&#xa;长句要等全部合成完才起播"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="230" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="音色表：tts_speakers/*.json 配上两套权重目录&#xa;本机有 da_fei_yv（v2Pro）和 da_fei_yv_plus（v2ProPlus）&#xa;默认音色：TTS_SPEAKER 优先，其次 da_fei_yv_plus"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="390" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="引擎按 25 Hz 语义帧出音频，16 个 token 约 0.64 s&#xa;min_chunk_length=16、overlap_length=2&#xa;重采样带 512 样本尾巴再丢掉，块边界才不爆音"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="550" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="单声道 16 kHz 16 位 = 32 000 B/s，一帧 1.5 s&#xa;数据段补零到 49 152 字节（24×2 048）&#xa;加 44 字节头，板上一共收到 49 200 字节&#xa;对齐一次 fread 的 2 048 字节，尾巴不再被当成文件尾"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="710" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="帧长小于 44 或大于 4 MiB 判为字节错位&#xa;只收到半帧就丢掉这一帧收尾&#xa;播半帧听着就是戛然而止"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="870" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="预热后实测：首帧 0.78 s～1.64 s，RTF 0.16～0.27&#xa;帧间隔最长 1.26 s，短于 1.536 s 一块，饿不着&#xa;刚预热的进程第一条回复另付 12 s～14 s 形状搜索"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="1030" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="一条回复最多 64 帧，约 98 s&#xa;超限只截尾，串口打 dropped the tail"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;"
                vertex="1" parent="1">
          <mxGeometry x="740" y="1200" width="520" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="队列只传文本指针"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#333333;"
                edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="HTTP 200 后开始收流"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#333333;"
                edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="同一进程内调用，换音色只重载权重"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#333333;"
                edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="每满一块 flush 一次"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#333333;"
                edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="webclient_read() 自己拼满帧"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#333333;"
                edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="close(fd) 后才切槽"
                style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#333333;"
                edge="1" parent="1" source="n6" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
