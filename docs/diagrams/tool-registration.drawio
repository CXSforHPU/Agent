                vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="100" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tag-loop" value="每轮请求"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;
                       align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="100" height="270" as="geometry" />
        </mxCell>
        <mxCell id="tag-clean" value="退出时"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;
                       align=center;verticalAlign=middle;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="100" height="90" as="geometry" />
        </mxCell>

        <mxCell id="stage-modules" value="① 工具模块文件&#xa;src/tools/ 下每个模块一个 .c：运算 3 个 · skill 1 个 · MQTT 1 个 · 设备框架 9 个&#xa;每个模块一张 struct agent_tool_def 表：name / describe / params / execute"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="180" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage-export" value="② 模块自注册&#xa;文件末尾写 AGENT_TOOL_MODULE_EXPORT(label, tools)&#xa;内核组件初始化阶段调 agent_tool_module_add()，把模块记进 src/utils/tool_json.c 的模块表"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="340" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage-chain" value="③ 建工具链表&#xa;init_tools() 调 agent_tool_register_modules() 遍历模块表&#xa;逐个工具建好 JSON 后 append_tool()，同一个模块登记两次也只算一份"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="500" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage-json" value="④ 生成工具定义&#xa;params 回调：create_property → create_param_obj&#xa;create_tool_item() 先放空 description，describe 回调再用 tool_desc / tool_desc_more 写功能说明"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="660" width="820" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stage-request" value="⑤ 发给模型&#xa;build_tools_json() 取工具数组，随 messages 一起写进请求体的 tools 字段&#xa;模型返回 tool_calls 时按名字查链表"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="860" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage-exec" value="⑥ 执行与回写&#xa;执行函数 tool_xxx(args, node) 把结果写进 node->ret.messages&#xa;框架以 role=tool 消息追加到上下文，进入下一轮"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="1020" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stage-cleanup" value="⑦ 清理&#xa;cleanup_agent_entry() 调 agent_tools_cleanup() 释放链表与残留结果&#xa;模块表是编译期静态数据，不释放；再次进入对话时重新注册"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;
                       fontSize=15;align=left;verticalAlign=middle;spacingLeft=16;"
                vertex="1" parent="1">
          <mxGeometry x="170" y="1180" width="820" height="90" as="geometry" />
        </mxCell>

