          <mxGeometry x="380" y="330" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="do-publish" value="mqtt_do_publish()"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
