          <mxGeometry x="380" y="230" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="参数合法？"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;"
