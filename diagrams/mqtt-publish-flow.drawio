          <mxGeometry x="380" y="460" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ensure" value="确保客户端已启动&#xa;必要时 mqtt_tool_start()"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="connected" value="连接成功？&#xa;默认等待 3 s"
                style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="380" y="680" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="paho" value="paho_mqtt_publish()&#xa;→ broker"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;"
                vertex="1" parent="1">
          <mxGeometry x="380" y="810" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="publish ok&#xa;回填 role=tool，LLM 继续"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;arcSize=50;"
