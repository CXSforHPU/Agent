# Kconfig file for package Agent
menuconfig PKG_USING_AGENT
    bool "Lightweight Agent software for RT-Thread"
    select PKG_USING_CJSON
    select PKG_USING_WEBCLIENT
    select PKG_USING_MBEDTLS
    select PKG_USING_MBEDTLS_DIGICERT_ROOT_CA
    select PKG_USING_MBEDTLS_CLOBALSIGN_ROOT_CA
    select RT_USING_ULOG

    # 完整版 vsnprintf（%f/%e、长整型等）的来源，按内核版本/klibc 能力自动判断：
    #   * RT-Thread < 5.0         : 内核 klibc 没有 rt_vsnprintf，需要 pkgs/rt_vsnprintf_full
    #   * RT-Thread >= 5.0 + klibc: 内核自带（rt_vsnprintf_std.c / rt_vsnprintf_tiny.c 都会定义该符号），
    #                               再启用该包会重复定义，链接报
    #                                   multiple definition of `rt_vsnprintf'
    #   * RT-Thread >= 5.0 + RT_KLIBC_USING_LIBC_VSNPRINTF=y: 内核不定义该符号，可用该包
    # 也可用下面的 VSNPRINTF_SRC_SEL 手动强制。
    select PKG_USING_RT_VSNPRINTF_FULL if (PKG_AGENT_VSNPRINTF_AUTO && PKG_AGENT_RT_VERSION_MAJOR < 5) || PKG_AGENT_VSNPRINTF_AUTO && RT_KLIBC_USING_LIBC_VSNPRINTF
    select PKG_USING_RT_VSNPRINTF_FULL if PKG_AGENT_VSNPRINTF_USE_PKG

    default n

if PKG_USING_AGENT

    config PKG_AGENT_PATH
        string
        default "/packages/ai/Agent"

    menu "Agent Build Options"

        config PKG_AGENT_RT_VERSION_MAJOR
            int "Target RT-Thread major version"
            range 3 9
            default 5
            help
                RT-Thread kernel major version this package is built against.
                Used to decide whether pkgs/rt_vsnprintf_full is needed:
                  < 5  : klibc has no rt_vsnprintf -> the package is selected
                  >= 5 : klibc provides it (unless RT_KLIBC_USING_LIBC_VSNPRINTF=y)
                         -> the package is NOT selected, avoiding a duplicate
                            `rt_vsnprintf' symbol at link time

        choice PKG_AGENT_VSNPRINTF_SRC_SEL
            prompt "Full vsnprintf source"
            default PKG_AGENT_VSNPRINTF_AUTO
            help
                Source of the full-featured vsnprintf (used for %f/%e and long integers).

            config PKG_AGENT_VSNPRINTF_AUTO
                bool "auto - decide by RT-Thread version and klibc capability (recommended)"
                help
                    RT-Thread < 5.0            -> select PKG_USING_RT_VSNPRINTF_FULL
                    RT-Thread >= 5.0 (klibc)   -> use the kernel implementation, no package
                    RT-Thread >= 5.0 (libc vsnprintf) -> select the package

            config PKG_AGENT_VSNPRINTF_USE_KLIB
                bool "kernel klibc only - never select rt_vsnprintf_full"
                help
                    Use this when you are sure the kernel already provides a full
                    rt_vsnprintf (RT_KLIBC_USING_VSNPRINTF_STANDARD=y on RT-Thread 5.x,
                    or RT_KLIBC_USING_LIBC_VSNPRINTF=y with newlib).

            config PKG_AGENT_VSNPRINTF_USE_PKG
                bool "pkgs/rt_vsnprintf_full - force select"
                help
                    Force using pkgs/rt_vsnprintf_full. You MUST also stop the kernel
                    from defining rt_vsnprintf, i.e. set
                        RT-Thread Kernel -> klibc -> RT_KLIBC_USING_LIBC_VSNPRINTF = y
                    otherwise the link fails with
                        multiple definition of `rt_vsnprintf'
        endchoice

    endmenu

    menu "Agent Runtime Configuration"
        config PKG_AGENT_API_KEY
            string "LLM service API Key"
            default "sk-**-**"
            help
                API key for accessing large-model LLM service.

        config PKG_AGENT_MODEL_NAME
            string "Target LLM model name"
            default "deepseek-ai/DeepSeek-V4-Pro"
            help
                Specify the target LLM model identifier.

        config PKG_AGENT_API_URL
            string "LLM API endpoint URL"
            default "https://api.siliconflow.cn/v1/chat/completions"
            help
                HTTP endpoint of LLM chat completion API.
                Default: https://api.siliconflow.cn/v1/chat/completions

        # Multimodal enable/disable choice (mode 开关)
        choice PKG_AGENT_MULTIMODAL_MODE_SEL
            prompt "Multimodal feature switch"
            default PKG_AGENT_MULTIMODAL_DISABLE
            help
                Enable or disable agent multimodal(image/file) capability.

            config PKG_AGENT_MULTIMODAL_DISABLE
                bool "Disable multimodal function"

            config PKG_AGENT_MULTIMODAL_ENABLE
                select WEBCLIENT_USING_FILE_DOWMLOAD
                bool "Enable multimodal function"
                help
                Enable image parsing and file upload/download for agent.
        endchoice

        if PKG_AGENT_MULTIMODAL_ENABLE
            menu "Agent File Server Settings"
                config PKG_AGENT_UPLOAD_URL
                    string "File upload HTTP URL"
                    default ""
                    help
                        HTTP file upload endpoint, example:
                        "http://10.0.2.2:8000/upload"

                config PKG_AGENT_DOWNLOAD_URL
                    string "File download URL template"
                    default ""
                    help
                        HTTP download url.
                        example: "https://10.0.2.2:8000/download"

                config PKG_AGENT_FILE_OP_THREAD_SIZE
                    int "File operation thread stack size"
                    default 4096
                    range 2048 16384
                    help
                        Stack size for agent file-operation worker thread.
            endmenu

            menu "Agent Driver"
                config PKG_AGENT_DRIVER_AUDIO
                    select PKG_USING_WAVPLAYER
                    select PKG_WP_USINGRECORD
                    select BSP_USING_AUDIO
                    bool "Enable Agent Driver Audio"
            endmenu

        endif

    endmenu

    menu "Buffer & Length Configuration"
        config PKG_AGENT_WEB_SOCKET_BUFSZ
            int "Webclient session buffer size"
            default 2048
            range 512 8192
            help
                Send/receive buffer size for webclient http session.

        config PKG_AGENT_RESP_BUFSZ
            int "HTTP response temporary buffer size"
            default 2048
            range 512 8192

        config PKG_AGENT_MAX_REASONING_LEN
            int "Max reasoning text buffer length"
            default 2048
            range 256 8192
            help
                Upper limit buffer length for LLM reasoning content.

        config PKG_AGENT_MAX_CONTENT_LEN
            int "Max chat message content length"
            default 2048
            range 256 8192
            help
                Maximum payload length of single chat message.

        config PKG_AGENT_STREAM_LINE_BUFSZ
            int "SSE streaming parse line buffer size"
            default 1024
            range 512 8192
            help
                Line buffer for parsing SSE streaming chunk response.
                NOTE: keep >= 1024. A single SSE chunk carrying tool_calls is
                about 310+ bytes, and an over-long line is discarded, which makes
                the framework miss tool calls (model looks like it never calls tools).

        config PKG_AGENT_MAX_TOOL_ARG_LEN
            int "Max tool-call JSON argument length"
            default 1024
            range 256 8192
            help
                Maximum buffer length for tool call JSON arguments.
                NOTE: keep >= 512; streaming arguments are appended fragment by
                fragment and are dropped once this limit is exceeded.

        config PKG_AGENT_MESSAGE_TRIM
            int "History message trim threshold"
            default 6
            range 2 64
            help
                Conversation history trim threshold, preserve system prompt,
                keep recent N pieces of user-assistant message context.
    endmenu

    choice PKG_AGENT_COMMUNICATION_CHANNEL_SEL
        prompt "Agent interaction communication channel"
        default PKG_AGENT_CLI_CHANNEL
        help
            Select input/output channel for agent user interaction.

        config PKG_AGENT_CLI_CHANNEL
            bool "CLI channel (RT-Thread MSH command-line)"
            help
                Interact with agent via MSH shell command line.

        config PKG_AGENT_WEBNET_CHANNEL
            select PKG_USING_WEBNET
            select WEBNET_USING_CGI
            bool "WebNet channel (WebSocket / HTTP)"
            help
                Interact with agent via web network service.

        config PKG_AGENT_DEBUG_CHANNEL
            bool "Debug test channel"
            help
                For developer test only, send message via msh command api.
    endchoice

    menu "Agent Tools Configuration"

        menu "Agent Tool: Mqtt Client"

            config PKG_AGENT_TOOL_MQTT_ENABLE
                bool "Enable MQTT client tool"
                select PKG_USING_PAHOMQTT
                # 工具依赖 paho 的 pipe 模式（UDP 模式不提供 publish/subscribe 接口）
                # 若 paho 侧把二者做成 choice，请确保选择 PAHOMQTT_PIPE_MODE
                select PAHOMQTT_PIPE_MODE
                default n
                help
                    Enable the MQTT tool set for the agent:
                      * mqtt_publish   : publish a command to a topic
                      * mqtt_subscribe : subscribe/unsubscribe topics at runtime
                                         (delivery mode: filter/auto/poll)
                      * mqtt_rule      : threshold rules, only wake the agent when out of range
                      * mqtt_history   : summarize recent messages/payloads + numeric
                                         min/max/avg, so the agent can assess the recent
                                         situation (read-only)
                      * mqtt_receive   : consume buffered messages on demand

                    Requires paho-mqtt in PIPE mode (selected automatically).

                    IMPORTANT (paho side, must be set in the paho menuconfig):
                      * PKG_PAHOMQTT_SUBSCRIBE_HANDLERS >= PKG_AGENT_TOOL_MQTT_MAX_SUB_TOPICS
                        (default 4; with the paho default of 1 only one topic can be subscribed)
                      * RT_PKG_MQTT_THREAD_STACK_SIZE >= 8192
                        (the paho worker opens "/dev/MQTTn" through DFS, whose path
                         resolution allocates ~12KB and needs stack; a 4KB stack
                         overflows it, corrupts heap metadata and hangs the system)

            if PKG_AGENT_TOOL_MQTT_ENABLE

                menu "MQTT Connection"

                    config PKG_AGENT_TOOL_MQTT_BROKER_URL
                        string "MQTT broker URL"
                        default "tcp://broker.emqx.io:1883"
                        help
                            Broker URL passed to paho. Only "tcp://host:port" or
                            "ssl://host:port" are accepted by paho (NOT "mqtt://").

                    config PKG_AGENT_TOOL_MQTT_CLIENT_ID
                        string "MQTT client ID"
                        default "rt-thread-agent"
                        help
                            MQTT client ID. Two devices sharing one ID will kick
                            each other's session off the broker.

                    config PKG_AGENT_TOOL_MQTT_USERNAME
                        string "MQTT username"
                        default ""

                    config PKG_AGENT_TOOL_MQTT_PASSWORD
                        string "MQTT password"
                        default ""

                    config PKG_AGENT_TOOL_MQTT_WILLMSG
                        string "MQTT will message"
                        default "Goodbye from RT-Thread Agent"
                        help
                            Last-will payload, published by the broker on the
                            publish topic when the client drops unexpectedly.

                    config PKG_AGENT_TOOL_MQTT_KEEPALIVE_SEC
                        int "MQTT keepalive interval (s)"
                        default 60
                        range 10 600

                    config PKG_AGENT_TOOL_MQTT_QOS
                        int "MQTT QoS level"
                        default 1
                        range 0 2
                        help
                            Reserved for compatibility: paho in PIPE mode only
                            implements QoS1, and the agent MQTT tool always uses
                            QoS1 regardless of this value.

                endmenu

                menu "MQTT Topics & Delivery"

                    config PKG_AGENT_TOOL_MQTT_PUB_TOPIC
                        string "Default publish topic"
                        default "agent/pub"
                        help
                            Topic used when a publish call does not specify one.

                    config PKG_AGENT_TOOL_MQTT_SUB_TOPIC
                        string "Default subscribe topic"
                        default "agent/sub"
                        help
                            Topic subscribed automatically when the client starts.

                    choice PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_SEL
                        prompt "Default topic delivery mode"
                        default PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_FILTER
                        help
                            How messages of subscribed topics are delivered to the agent.

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_FILTER
                            bool "filter - only advice/threshold breaches wake the agent"
                            help
                                Messages are filtered locally: the agent is only
                                woken up when a message looks like a question or
                                matches an mqtt_rule threshold. Routine data is
                                counted and kept in the per-topic history instead.

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_AUTO
                            bool "auto - forward every message"

                        config PKG_AGENT_TOOL_MQTT_DEFAULT_MODE_POLL
                            bool "poll - never forward, fetch with mqtt_receive/mqtt_history"
                    endchoice

                    config PKG_AGENT_TOOL_MQTT_AUTO_SUB_DEFAULT
                        bool "Auto subscribe the default topic at startup"
                        default y

                endmenu

                menu "MQTT Capacity & Buffers"

                    config PKG_AGENT_TOOL_MQTT_BUF_SIZE
                        int "paho send/receive buffer size"
                        default 1024
                        range 256 8192
                        help
                            Buffer used by paho for building/parsing packets.

                    config PKG_AGENT_TOOL_MQTT_MAX_SUB_TOPICS
                        int "Max concurrent subscriptions"
                        default 4
                        range 1 16
                        help
                            Capped automatically by paho's MAX_MESSAGE_HANDLERS
                            (PKG_PAHOMQTT_SUBSCRIBE_HANDLERS).

                    config PKG_AGENT_TOOL_MQTT_MAX_RULES
                        int "Max threshold rules"
                        default 4
                        range 1 16

                    config PKG_AGENT_TOOL_MQTT_TOPIC_MAX_LEN
                        int "Topic string buffer length"
                        default 64
                        range 16 256

                    config PKG_AGENT_TOOL_MQTT_PAYLOAD_MAX_LEN
                        int "Max received payload length"
                        default 256
                        range 32 1024
                        help
                            Longer payloads are truncated and marked as truncated.

                    config PKG_AGENT_TOOL_MQTT_MAX_PUB_LEN
                        int "Max published payload length"
                        default 256
                        range 32 1024
                        help
                            Also bounded by the paho buffer and the rt_pipe size;
                            a too-long publish is rejected with an error text.

                    config PKG_AGENT_TOOL_MQTT_FIELD_MAX_LEN
                        int "Max JSON field name length (rules)"
                        default 24
                        range 8 64

                    config PKG_AGENT_TOOL_MQTT_LAST_PAYLOAD_LEN
                        int "Cached last-payload length per topic"
                        default 96
                        range 16 256
                        help
                            Last payload per subscription, shown by mqtt_tool status
                            so the agent can answer "what is the current value".

                    config PKG_AGENT_TOOL_MQTT_HISTORY_DEPTH
                        int "Recent messages kept per topic (mqtt_history)"
                        default 8
                        range 1 32
                        help
                            Per-topic ring of recent raw payloads. This is the data
                            source of the mqtt_history tool, which summarizes recent
                            readings plus numeric min/max/avg/last for the agent -
                            including messages that were filtered locally and never
                            sent to the LLM. mqtt_history is read-only; mqtt_receive
                            consumes the separate buffered-message window.

                    config PKG_AGENT_TOOL_MQTT_HISTORY_PAYLOAD_LEN
                        int "Payload length kept in history"
                        default 128
                        range 16 512
                        help
                            Longer payloads are stored truncated in the history.

                    config PKG_AGENT_TOOL_MQTT_RX_QUEUE_DEPTH
                        int "Receive queue depth (callback -> rx thread)"
                        default 16
                        range 2 64
                        help
                            Messages queue here while the agent is busy; the oldest
                            is dropped when full.

                    config PKG_AGENT_TOOL_MQTT_POLL_DEPTH
                        int "Rolling window depth"
                        default 8
                        range 1 32
                        help
                            Ring buffer for poll mode and for locally filtered
                            messages, consumed on demand with mqtt_receive.

                endmenu

                menu "MQTT Throttling & Alerts"

                    config PKG_AGENT_TOOL_MQTT_INJECT_MIN_INTERVAL_MS
                        int "Min interval between two agent injections (ms)"
                        default 1000
                        range 0 60000
                        help
                            Guards the LLM endpoint: requests sent too frequently
                            get reset by the server/proxy, which shows up as
                            "mbedtls_client_read data error -0x4c" plus
                            "chat: POST failed http status=-76".

                    config PKG_AGENT_TOOL_MQTT_INJECT_BATCH_MAX
                        int "Max messages merged into one injection"
                        default 5
                        range 1 16

                    config PKG_AGENT_TOOL_MQTT_BUSY_WAIT_MS
                        int "Max wait for an idle agent before buffering (ms)"
                        default 180000
                        range 0 900000
                        help
                            While the agent is handling a previous round, incoming
                            messages wait (and are merged) instead of interrupting
                            it. On timeout they go to the rolling window instead.

                    config PKG_AGENT_TOOL_MQTT_ALERT_COOLDOWN_MS
                        int "Alert cooldown per rule (ms)"
                        default 60000
                        range 0 3600000
                        help
                            A rule alerts on the rising edge, and again after this
                            cooldown while it stays out of range.

                    config PKG_AGENT_TOOL_MQTT_LOCK_WAIT_MS
                        int "State lock wait timeout (ms)"
                        default 1000
                        range 1 10000
                        help
                            The tool never waits forever on its state lock, so a
                            stuck peer cannot freeze the agent loop or MSH.

                endmenu

                menu "MQTT Timeouts & Thread"

                    config PKG_AGENT_TOOL_MQTT_CONNECT_WAIT_MS
                        int "Wait for connection before publish (ms)"
                        default 3000
                        range 0 60000

                    config PKG_AGENT_TOOL_MQTT_SUB_WAIT_MS
                        int "Wait for subscription to take effect (ms)"
                        default 3000
                        range 0 60000

                    config PKG_AGENT_TOOL_MQTT_RX_THREAD_STACK
                        int "RX thread stack size"
                        default 3072
                        range 2048 16384

                    config PKG_AGENT_TOOL_MQTT_RX_THREAD_PRIO
                        int "RX thread priority"
                        default 15
                        range 1 254
                        help
                            Lower number = higher priority.

                endmenu

            endif

        endmenu

    endmenu


    # Package source version choice
    # NOTE: currently only master branch option, extend more tag/commit later
    choice PKG_AGENT_VERSION_SEL
        prompt "Agent package source version"
        default PKG_USING_AGENT_LATEST_VERSION
        help
            Select git source version for agent package.

        config PKG_USING_AGENT_LATEST_VERSION
            bool "latest (master branch)"
    endchoice

    config PKG_AGENT_VER
        string
        default "latest" if PKG_USING_AGENT_LATEST_VERSION

endif